#!/usr/bin/env bash
# Короткая обёртка вокруг tools/smoke.py.
#
# Зачем: в браузерной консоли Hetzner длинная команда переносится по пробелу и
# рвётся пополам — вместо запуска скрипта стартует интерактивный python. Здесь
# команда короткая и переносить нечего.
#
#   cd /root/orderbook-recorder && ./smoke
cd "$(dirname "$0")" || exit 1
exec venv/bin/python tools/smoke.py "$@"
