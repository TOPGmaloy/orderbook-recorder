#!/usr/bin/env bash
# Короткая обёртка вокруг tools/report.py.
#
# Зачем обёртка: в браузерной консоли Hetzner длинная команда переносится по
# пробелу и рвётся пополам — вместо запуска скрипта стартует интерактивный
# python. Здесь переносить нечего.
#
# Вывод дублируется в out/report.txt, откуда его отдаёт страница на 8080 — так
# результат можно прочитать в браузере, не переписывая с экрана.
cd "$(dirname "$0")" || exit 1
mkdir -p out
venv/bin/python tools/report.py "$@" 2>&1 | tee "out/report.txt"
exit "${PIPESTATUS[0]}"
