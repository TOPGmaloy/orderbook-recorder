#!/usr/bin/env bash
# Короткая обёртка вокруг tools/tails.py — замер риска плеча.
#
# Зачем обёртка: в браузерной консоли Hetzner длинная команда переносится по
# пробелу и рвётся пополам. Здесь переносить нечего.
#
# Вывод дублируется в out/tails.txt, откуда его отдаёт страница на 8080.
cd "$(dirname "$0")" || exit 1
mkdir -p out
venv/bin/python tools/tails.py "$@" 2>&1 | tee "out/tails.txt"
exit "${PIPESTATUS[0]}"
